# Public origin used for metadata and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated admin accounts. Admin APIs also require authenticated Sites/ChatGPT identity.
ADMIN_EMAILS=admin@example.com

# IGDB server-only credentials. Never prefix these with NEXT_PUBLIC_.
IGDB_CLIENT_ID=
IGDB_ACCESS_TOKEN=

# HMAC secret for temporary upload and playback URLs (use at least 32 random bytes).
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Optional source cache / future Upstash adapter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logical Sites bindings are declared in .openai/hosting.json:
# D1: DB
# R2: MEDIA
