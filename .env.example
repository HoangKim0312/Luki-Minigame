# Railway backend
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,https://hoangkim0312.github.io

# GitHub Pages frontend calls the Railway backend through this public HTTPS URL.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase server-only configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_MEDIA_BUCKET=licensed-media

# IGDB server-only credentials.
IGDB_CLIENT_ID=
IGDB_ACCESS_TOKEN=

# Optional distributed cache/rate-limit adapter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
