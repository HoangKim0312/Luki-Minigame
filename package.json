{
  "name": "anigame-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx --env-file-if-exists=.env.local server/index.ts",
    "start:server": "tsx server/index.ts",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "build": "next build",
    "build:pages": "cross-env GITHUB_PAGES=true NEXT_PUBLIC_SITE_URL=https://hoangkim0312.github.io/Luki-Minigame next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
